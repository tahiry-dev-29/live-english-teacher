{
  "name": "feature-live",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/backend/feature-live/src",
  "projectType": "library",
  "tags": ["backend", "feature"],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --experimental-strip-types --experimental-transform-types --test libs/backend/feature-live/src/lib/**/*.spec.ts",
        "cwd": "{workspaceRoot}"
      },
      "configurations": {
        "watch": {
          "command": "node --experimental-strip-types --experimental-transform-types --test --watch libs/backend/feature-live/src/lib/**/*.spec.ts"
        }
      }
    }
  }
}
