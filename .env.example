PORT=3000
DATABASE_URL="postgresql://user:password@localhost:5432/live-english-teacher?schema=public"

GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

apiUrlBase="https://generativelanguage.googleapis.com/v1beta/models/"

# AI provider: "gemini" (default) or "groq"
AI_PROVIDER=gemini
GROQ_API_KEY=
AI_MODEL=llama-3.3-70b-versatile
AI_FALLBACK_MODEL=llama-3.1-8b-instant
